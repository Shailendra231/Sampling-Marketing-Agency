// Cloudflare deploys this Worker through nitro, which generates the real config
// at .output/server/wrangler.json during `npm run build` and points wrangler at
// it via .wrangler/deploy/config.json. That redirect takes precedence over this
// file, so the values here are a mirror, not the source of truth.
//
// This file exists so that a root config is ALWAYS present. Without one,
// `wrangler deploy` treats the project as unconfigured, runs C3 framework
// detection, and tries to rewrite vite.config.ts — which fails with "Cannot
// modify Vite config: could not find a valid plugins array", because the
// Lovable defineConfig wrapper has no plugins array of its own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sampling-marketing-agency",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  // Nitro emits pre-split ES modules and loads the route chunks at runtime.
  // These two mirror the generated config so that whichever config wrangler
  // resolves, the upload is identical — without them wrangler re-bundles the
  // output with esbuild, which is a different code path than nitro intends.
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "observability": {
    "enabled": true
  },
  // Custom domains match exact hostnames — no wildcards — so apex and www are
  // separate entries. These require productsamplingagency.in to be an ACTIVE
  // zone in this Cloudflare account; until the nameservers move off Hostinger,
  // `wrangler deploy` fails with a zone-not-found error.
  "routes": [
    { "pattern": "productsamplingagency.in", "custom_domain": true },
    { "pattern": "www.productsamplingagency.in", "custom_domain": true }
  ],
  // Wrangler runs this itself before deploying, so the deploy does not depend on
  // a Build command being configured in the Workers Builds dashboard.
  "build": {
    "command": "npm run build"
  }
}
